            "schema": {
              "type": "string",
              "example": "15"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Cantidad máxima de registros por listado",
            "schema": {
              "type": "integer",
              "default": 10,
              "example": 10
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "description": "Cantidad de registros a omitir",
            "schema": {
              "type": "integer",
              "default": 0,
              "example": 0
            }
          },
          {
