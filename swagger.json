    "/partidos/jugador": {
      "get": {
        "summary": "Obtiene los partidos pasados y pendientes de un jugador",
        "description": "Retorna los partidos asociados a un jugador, separados en pendientes (futuros) y pasados. La solicitud requiere autenticación mediante la cabecera **x-api-key**.\n",
